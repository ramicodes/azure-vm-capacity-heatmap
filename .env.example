# Choose managed (Power Apps), standalone (MSAL), cli (local only), or hosted (App Service).
VITE_ARM_MODE=standalone
# CLI: use VITE_ARM_MODE=cli and run node scripts\cli-arm-server.mjs separately.
# CLI requires exactly http://127.0.0.1:5173 and needs none of the MSAL settings below.
# Hosted builds use VITE_ARM_MODE=hosted and VITE_BASE=/.
# App Service settings and managed identity are server-only; see README deployment steps.
# Optional server-only restriction; blank keeps CLI discovery unrestricted.
# The bridge reads this from .env.local at startup. Restart the bridge after changes.
ARM_SUBSCRIPTION_ID=
# Optional CLI-only disk cache of projected VM catalog metadata (never credentials).
# Isolated by CLI context and subscription, expires after 15 minutes.
ARM_SKU_CACHE=false
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=http://127.0.0.1:5173/
